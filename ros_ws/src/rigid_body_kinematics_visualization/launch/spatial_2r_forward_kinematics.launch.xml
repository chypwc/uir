<launch>
    <arg name="animate" default="false" />

    <node
        pkg="rigid_body_kinematics_visualization"
        exec="spatial_2r_forward_kinematics_demo"
        name="spatial_2r_forward_kinematics_demo"
        output="screen">
        <param name="animate" value="$(var animate)" />
        <param name="use_sim_time" value="false" />
    </node>

    <node
        pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        output="screen"
        args="-d $(find-pkg-share rigid_body_kinematics_visualization)/rviz/spatial_2r_forward_kinematics.rviz">
        <param name="use_sim_time" value="false" />
    </node>
</launch>
