<?xml version="1.0"?>
<package format="3">
    <name>rigid_body_kinematics_visualization</name>
    <version>0.0.0</version>
    <description>Spatial two-joint forward-kinematics visualization.</description>
    <maintainer email="chienyeh5@gmail.com">maxwell</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rigid_body_kinematics</depend>
    <depend>rclcpp</depend>
    <depend>visualization_msgs</depend>
    <depend>geometry_msgs</depend>

    <test_depend>ament_cmake_gtest</test_depend>

    <exec_depend>ros2launch</exec_depend>
    <exec_depend>launch_xml</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>rviz2</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>

</package>
